# PostgreSQL (Railway: copia la URL del plugin Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Demo pública: bloquea POST/PATCH/DELETE en la API y deshabilita formularios.
# true | 1 = solo lectura (recomendado en portafolio expuesto). false o vacío = edición permitida.
NEXT_PUBLIC_DEMO_READONLY=true
